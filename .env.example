# ==============================================================================
# Multimodal Coding Agent Team - Environment Variables
# ==============================================================================
# Copy this file to .env and insert your API keys:
# cp .env.example .env

# Google Gemini API Key (Required for Vision, Architect, Developer, QA agents)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# E2B API Key (Required for isolated cloud sandbox code execution)
# Get yours at: https://e2b.dev/
E2B_API_KEY=your_e2b_api_key_here

# OpenAI API Key (Optional fallback / alternate provider)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
